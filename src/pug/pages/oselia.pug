
extends ../layout/main
block variable
  -
    var title_page = 'oselia'
    var id_page = 'id-page-oselia'
    var class_page = 'class-page-oselia'
    var headerCustomClass = 'type1' 
    var breadcrumbsSubitem = [
      {
        label: 'About',
        link: pagesLink[0].about
      }
    ]
    var title = 'ЄОСЕЛЯ — ПРОГРАМА ДОСТУПНОГО КРЕДИТУВАННЯ ЖИТЛА'
    var subtitle = 'Купуйте житло в ЖК Свідомі за державною програмою доступного іпотечного кредитування'
    var descriptionStrong = ''
    var descriptionNormal = ''
    var bgImg = {
      src: "./assets/images/oselia-hero.jpg",
      alt: "building"
    }
    var heroClasses = {
      title: "small-title",
      subtitle: "with-padding"
    }
    var anchor = '#oselia'
block meta
  title= title_page
  meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
  script(defer src='./assets/scripts/vendors.bundle.js')
  script(defer src='./assets/scripts/header.bundle.js')
  script(defer src='./assets/scripts/footer.bundle.js')
  script(defer src='./assets/scripts/oselia.bundle.js')
block content
  include ../includes/hero.pug
  section.oselia.container 
    .oselia-block
      h2.oselia-block__title Хто може приймати участь:
      .oselia-block__content
        .oselia-subblock
          h3.oselia-subblock__title Пільгові категорії:
          .oselia-subblock__content-list  
            .oselia-subblock__content-item 
              p.number ➀
              p.text Військовослужбовці за контрактом: захисники України, силовики та члени їхніх сімей
            .oselia-subblock__content-item 
              p.number ➁
              p.text Мобілізовані військовослужбовці
            .oselia-subblock__content-item 
              p.number ➂
              p.text Медичні працівники: фахівці та професіонали закладів охорони здоров’я державної та комунальної форми власності
            .oselia-subblock__content-item 
              p.number ➃
              p.text Педагогічні працівники: закладів освіти державної та комунальної форми власності
            .oselia-subblock__content-item
              p.number ➄
              p.text Наукові та науково-педагогічні працівники: закладів освіти й наукових установ державної або комунальної форми власності
        .oselia-subblock
          h3.oselia-subblock__title Інші категорії:
          .oselia-subblock__content-list  
            .oselia-subblock__content-item 
              p.number ➀
              p.text Учасники бойових дій, а також ветерани війни та члени їх сімей
            .oselia-subblock__content-item 
              p.number ➁
              p.text Сім’ї загиблих чи померлих Захисників та Захисниць України
            .oselia-subblock__content-item 
              p.number ➂
              p.text Особи з інвалідністю отриманою внаслідок війни, сім’ї загиблих або померлих ветеранів
            .oselia-subblock__content-item 
              p.number ➃
              p.text Ті, хто не має власного житла або його площа менша, ніж 52,5 м² + 21 м² на кожного наступного члена сім’ї
            .oselia-subblock__content-item
              p.number ➄
              p.text Внутрішньо переміщені особи
    .oselia-block--withbg
      h2.oselia-block__title Основні умови:
      .oselia-block__content
        .oselia-subblock
          .oselia-subblock__content-list  
            .oselia-subblock__content-item 
              h3.content-item__title Ставка
              .content-item__wrapper
                .content-item__text-wrap
                  h4 Пільгові категорії
                  p 3% перші 10 років, далі — 6%
                .content-item__text-wrap
                  h4 Інші категорії
                  p 7%, перші 10 років, далі — 10%
            .oselia-subblock__content-item 
              h3.content-item__title Перший внесок
              .content-item__wrapper
                .content-item__text-wrap
                  h4 20% від вартості житла
                .content-item__text-wrap
                  h4 10% для молоді віком до 25 років
            .oselia-subblock__content-item 
              h3.content-item__title Термін
              .content-item__wrapper
                .content-item__text-wrap
                  h4 Кредитування надається до 20 років
    .oselia-block
      h2.oselia-block__title Яке житло можна обрати
      .oselia-block__content
        .oselia-subblock
          h3.oselia-subblock__title У ЖК Свідомі ви можете придбати квартиру, що відповідає всім вимогам програми:
          .oselia-subblock__content-list.oselia-subblock__content-list--withtitles
            .oselia-subblock__content-item 
              h4.title Площа: 
              p.text До 52,5 м² на одного або двох, +21 м² на кожного наступного члена родини.
            .oselia-subblock__content-item 
              h4.title Допустиме перевищення: 
              p.text +10% до нормативної площі (оплачується коштом першого внеску).
            .oselia-subblock__content-item 
              h4.title Гранична ціна:
              p.text Розраховується на основі опосередкованої вартості будівництва для Київська область із застосуванням коефіцієнта 2,0. Актуальне значення переглядається щоквартально відповідно до умов програми єОселя
    
    .oselia-block--withbg
      h2.oselia-block__title Площею:
      .oselia-block__content
        .oselia-subblock
          .oselia-subblock__content-list.oselia-subblock__content-list--withnumbers
            .oselia-subblock__content-item 
              p.number ➀
              p.text Для квартир — до 52,5 м² загальної площі на одну особу та 21 м² додатково на кожного наступного члена сім’ї
            .oselia-subblock__content-item 
              p.number ➁
              p.text з 9 лютого 2026 р: Для квартир до 52,5 м² загальної площі на 1 або 2 осіб, та 21 м² додатково на кожного наступного члена сім’ї
            .oselia-subblock__content-item 
              p.number ➂
              p.text Для таунхаусів та приватних будинків — до 62,5 м² на одну особу та 21 м² додатково на кожного наступного члена сім’ї
            .oselia-subblock__content-item.oselia-subblock__content-item--withtitle
              h4.title Перевищення дозволене виключно для нерухомості віком до трьох років, але не більш як на 10%.
              .inner-item-wrap
                p.number ➀
                p.text Для сім’ї з мами (або батька) і дитини, 52,5 м² + 10% = 57, 75 м²
              .inner-item-wrap
                p.number ➁
                p.text Для сім’ї з мами (або батька) і дитини, 52,5 м² + 10% = 57, 75 м²
              .inner-item-wrap
                p.number ➂
                p.text Для сім’ї з мами (або батька) і дитини, 52,5 м² + 10% = 57, 75 м²
            .oselia-subblock__content-item.oselia-subblock__content-item--withtitle
              h4.title Понаднормову площу та вартість позичальник матиме покрити коштом першого внеску.
              .inner-item-wrap
                p.number ➀
                p.text Для житла, “старшого” за 3 роки, перевищення нормативної площі не допускатиметься
              .inner-item-wrap
                p.number ➁
                p.text Максимальна площа — 115,5 м² незалежно від кількості членів сім’ї
              .inner-item-wrap
                p.number ➂
                p.text Для сім’ї з мами (або батька) і дитини, 52,5 м² + 10% = 57, 75 м²


    .oselia-block
      h2.oselia-block__title Приклади розрахунку площі
      .oselia-block__content
        .oselia-subblock
          .oselia-subblock__content-list
            .oselia-subblock__content-item 
              p.text 1 особа або сім'я з 2-х людей: до 57,75 м² 
            .oselia-subblock__content-item 
              p.text Родина з 3-х людей: до 80,85 м²
            .oselia-subblock__content-item 
              p.text Максимальна площа за програмою: 115,5 м²
                 
                
              
    .oselia-block--withbg
      h2.oselia-block__title 5 кроків до власної квартири
      .oselia-block__content
        .oselia-subblock
          .oselia-subblock__content-list.oselia-subblock__content-list--withnumbers
            .oselia-subblock__content-item 
              p.number ➀
              h4.title Заявка.
              p.text Виберіть послугу єОселя в застосунку Дія.
            .oselia-subblock__content-item 
              p.number ➁
              h4.title Схвалення.
              p.text Отримайте пропозиції від банків та оберіть свій.
            .oselia-subblock__content-item 
              p.number ➂
              h4.title Перевірка.
              p.text Надайте документи до банку для фінального підтвердження.
            .oselia-subblock__content-item 
              p.number ➃
              h4.title Вибір.
              p.text Виберіть квартиру в ЖК Свідомі та передайте документи в банк.
            .oselia-subblock__content-item
              p.number ➄
              h4.title Угода.
              p.text Підпишіть договори з банком та забудовником — квартира ваша!
    .oselia-block
      h2.oselia-block__title Банки партнери:
      .oselia-block__content
